# ── Runtime ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (production) or a local mongod URI.
# If empty in development the API starts a disposable in-memory MongoDB
# (data resets on restart). It refuses to start without a URI in production.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/glorison-journal?retryWrites=true&w=majority

# ── Session ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 48  (minimum 32 characters)
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# lax for same-site hosting, none when the frontend is on another origin
# (Netlify -> Render). SameSite=None always forces Secure cookies.
COOKIE_SAME_SITE=lax
# Optional: only set when the API and frontend share a parent domain.
# COOKIE_DOMAIN=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated exact origins, no trailing slash.
# Example: https://journal.netlify.app,https://journal.example.com
CLIENT_ORIGIN=http://localhost:5173

# ── Seeded administrator (used by `npm run seed` only) ───────────────────────
ADMIN_USERNAME=glorison
ADMIN_EMAIL=admin@glorison.local
ADMIN_PASSWORD=change-this-password
