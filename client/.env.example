# Frontend environment (Vite).
#
# Leave this unset for local development and single-service deployments: the
# client calls the relative /api path, which Vite proxies to localhost:5000.
#
# For a split deployment (Netlify frontend, Render backend) set the API origin
# including the /api suffix, with no trailing slash:
# VITE_API_URL=https://cyber-journal-api.onrender.com/api
#
# VITE_API_URL=http://localhost:5000/api
